<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package: gives Midfielder.exe package identity (without installing it as an MSIX) so Windows 11 shows
  "Send to phone" at the top of Explorer's right-click menu. The files live next to Midfielder.exe (the
  package's external location); this package only carries the manifest and logos.
  CI stamps Version; Publisher must match midfielder-sideload.cer and the msix element in app.manifest.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop desktop4 desktop5 com rescap">
  <Identity Name="Midfielder" Publisher="CN=Midfielder sideload" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Midfielder</DisplayName>
    <PublisherDisplayName>Midfielder</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- Experimental "talk through this PC": the phone as this PC's Bluetooth hands-free line. -->
    <rescap:Capability Name="phoneLineTransportManagement" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
  <Applications>
    <Application Id="Midfielder" Executable="Midfielder.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="Midfielder" Description="Send files to your phone"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="MidfielderSendToPhone" Clsid="5009E094-7566-4276-BCE2-E254ADA449BC" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="MidfielderSendFolderToPhone" Clsid="5009E094-7566-4276-BCE2-E254ADA449BC" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Midfielder: Send to phone">
              <com:Class Id="5009E094-7566-4276-BCE2-E254ADA449BC" Path="MidfielderShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- With package identity, the buttons and reply box on Midfielder's Windows notifications are delivered
             through this activator (the notifications toolkit reads the CLSID from here). -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="7C3A5D7E-2B1F-4E8A-9C6D-3F2E1A0B5C4D" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Midfielder.exe" Arguments="-ToastActivated" DisplayName="Midfielder notifications">
              <com:Class Id="7C3A5D7E-2B1F-4E8A-9C6D-3F2E1A0B5C4D" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
