<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Protobuf-generated code and test naming conventions trip a few style analyzers; keep real bug analyzers on. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1716;CA1720;CA1028;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1515;CA1848;CA1849;CA1859;CA1873;CA2007;CA5394;CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
