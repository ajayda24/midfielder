<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The main window is WPF + WPF-UI (Fluent); the tray, clipboard and dialogs stay WinForms. -->
    <UseWPF>true</UseWPF>
    <!-- [LibraryImport] P/Invoke source generation emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\midfielder.ico</ApplicationIcon>
    <AssemblyName>Midfielder</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Smaller working set and faster idle: no tiered PGO bookkeeping kept around. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- No InvariantGlobalization: WPF needs culture data to parse control templates and lay out text
         ("Cannot find non-neutral culture related to 'en-us'"); without it the window never opens. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Actionable Windows notifications (reply box, buttons) for an unpackaged app. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- WASAPI loopback capture: this PC's sound, streamed to the phone. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Midfielder.Core/Midfielder.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both WPF and WinForms are referenced: no implicit global usings for either, so names never clash. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- UseWPF drops these from the implicit usings (System.IO.Path vs System.Windows.Shapes.Path); keep them. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\midfielder.ico" LogicalName="midfielder.ico" />
    <!-- Windows 11 menu: the signed sparse package (built by CI, passed as -p:MenuPackage=path) and its
         certificate. Without MenuPackage the menu switch shows as unavailable. -->
    <EmbeddedResource Include="..\packaging\midfielder-sideload.cer" LogicalName="menu/midfielder-sideload.cer" />
    <EmbeddedResource Include="$(MenuPackage)" LogicalName="menu/Midfielder.msix" Condition="'$(MenuPackage)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Midfielder.App.Tests" />
  </ItemGroup>
</Project>
